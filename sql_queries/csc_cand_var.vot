<?xml version="1.0"?>
<VOTABLE version="1.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.ivoa.net/xml/VOTable/v1.2"
  xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.2 http://www.ivoa.net/xml/VOTable/v1.2"
  xmlns:stc="http://www.ivoa.net/xml/STC/v1.30">
<RESOURCE name="CSC">
<TABLE name="null">
<FIELD ID="col0" datatype="int" name="usrid" ucd="meta.id" width="7">
<DESCRIPTION>User Table identifier</DESCRIPTION>
<VALUES null='-2147483648'/>
</FIELD>
<FIELD ID="col1" datatype="double" name="separation" precision="F2" ucd="pos.angDistance" unit="arcsec" width="9">
<DESCRIPTION>Distance from master source to user source</DESCRIPTION>
</FIELD>
<FIELD ID="col2" datatype="double" name="probability" precision="F2" ucd="stat.probability" width="9">
<DESCRIPTION>Probability that master source and user source are a match</DESCRIPTION>
</FIELD>
<FIELD ID="col3" arraysize="*" datatype="char" name="name" width="22">
<DESCRIPTION>Source name in the format '2CXO Jhhmmss.s{+|-}ddmmss[X]'</DESCRIPTION>
</FIELD>
<FIELD ID="col4" datatype="double" name="flux_aper_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col5" datatype="double" name="flux_aper_lolim_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% lower confidence limit); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col6" datatype="double" name="flux_aper_hilim_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% upper confidence limit); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col7" datatype="short" name="var_intra_index_h" width="2">
<DESCRIPTION>Intra-observation Gregory-Loredo variability index in the range [0, 10]: indicates whether the source region photon flux is constant within an observation (highest value across all observations); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD ID="col8" datatype="double" name="var_intra_prob_h" precision="F3">
<DESCRIPTION>Intra-observation Gregory-Loredo variability probability (highest value across all observations); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col9" datatype="double" name="ks_intra_prob_h" precision="F3">
<DESCRIPTION>Intra-observation Kolmogorov-Smirnov test variability probability (highest value across all observations); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col10" datatype="double" name="kp_intra_prob_h" precision="F3">
<DESCRIPTION>Intra-observation Kuiper's test variability probability (highest value across all observations); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col11" datatype="short" name="var_inter_index_h" width="2">
<DESCRIPTION>Inter-observation variability index in the range [0, 10]: indicates whether the source region photon flux is constant between observations; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD ID="col12" datatype="double" name="var_inter_prob_h" precision="F3">
<DESCRIPTION>Inter-observation variability probability, calculated from the chi^2 distribution of the photon fluxes of the individual observations; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col13" datatype="double" name="var_inter_sigma_h" precision="E4" unit="photon/s/cm^2">
<DESCRIPTION>Inter-observation flux variability standard deviation; the spread of the individual observation photon fluxes about the error weighted mean; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col14" datatype="int" name="obsid" width="5">
<DESCRIPTION>Observation identifier</DESCRIPTION>
<VALUES null='-2147483648'/>
</FIELD>
<FIELD ID="col15" datatype="short" name="obi" width="3">
<DESCRIPTION>Observation interval number</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD ID="col16" datatype="short" name="region_id" width="4">
<DESCRIPTION>Detection region identifier (component number)</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD ID="col17" datatype="double" name="theta" precision="F3" unit="arcmin">
<DESCRIPTION>PSF 90% ECF aperture off-axis angle</DESCRIPTION>
</FIELD>
<FIELD ID="col18" datatype="double" name="flux_aper_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected detection net energy flux inferred from the source region aperture, calculated by counting X-ray events; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col19" datatype="double" name="flux_aper_lolim_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected detection net energy flux inferred from the source region aperture, calculated by counting X-ray events (68% lower confidence limit); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col20" datatype="double" name="flux_aper_hilim_h" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected detection net energy flux inferred from the source region aperture, calculated by counting X-ray events (68% upper confidence limit); ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col21" datatype="short" name="var_index_h" width="2">
<DESCRIPTION>Intra-observation Gregory-Loredo variability index in the range [0, 10]: indicates whether the source region photon flux is constant within an observation; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
<FIELD ID="col22" datatype="double" name="var_prob_h" precision="F3">
<DESCRIPTION>Intra-observation Gregory-Loredo variability probability; ACIS hard (2.0-7.0 keV) energy band</DESCRIPTION>
</FIELD>
